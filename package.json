{
  "name": "telegram-support-in-topics-bot",
  "version": "1.1.0",
  "description": "Minimal Telegram support bot that creates forum topics for each user conversation",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "node --test --import tsx \"tests/**/*.test.ts\""
  },
  "keywords": [
    "telegram",
    "bot",
    "support",
    "forum-topics",
    "helpdesk",
    "grammy"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
